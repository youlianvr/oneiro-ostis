/*
 * Oneiro-OSTIS experience ontology.
 *
 * Experience = attempts linked to subjects, actions, outcomes and to each
 * other chronologically. The dream cycle reads this graph and replays
 * alternative strategies over it.
 */

/* ---------- classes ---------- */

concept_experience_event <- sc_node_class;;
concept_experience_event
=> nrel_main_idtf:
    [experience event]
    (* <- lang_en;; *);;

concept_attempt <- sc_node_class;;
concept_attempt
<= nrel_inclusion: concept_experience_event;;
concept_attempt
=> nrel_main_idtf:
    [attempt]
    (* <- lang_en;; *);;

concept_outcome <- sc_node_class;;
concept_outcome
=> nrel_main_idtf:
    [outcome]
    (* <- lang_en;; *);;

concept_subject <- sc_node_class;;
concept_subject
=> nrel_main_idtf:
    [subject]
    (* <- lang_en;; *);;

concept_action_kind <- sc_node_class;;
concept_action_kind
=> nrel_main_idtf:
    [action kind]
    (* <- lang_en;; *);;

/* ---------- outcome constants ---------- */

concept_success <- concept_outcome;;
concept_success
=> nrel_main_idtf:
    [success]
    (* <- lang_en;; *);;

concept_failure <- concept_outcome;;
concept_failure
=> nrel_main_idtf:
    [failure]
    (* <- lang_en;; *);;

/* ---------- non-role relations ---------- */

nrel_subject <- sc_node_non_role_relation;;
nrel_subject
=> nrel_main_idtf:
    [subject of attempt*]
    (* <- lang_en;; *);;

nrel_action <- sc_node_non_role_relation;;
nrel_action
=> nrel_main_idtf:
    [action of attempt*]
    (* <- lang_en;; *);;

nrel_object <- sc_node_non_role_relation;;
nrel_object
=> nrel_main_idtf:
    [object of attempt*]
    (* <- lang_en;; *);;

nrel_outcome <- sc_node_non_role_relation;;
nrel_outcome
=> nrel_main_idtf:
    [outcome of attempt*]
    (* <- lang_en;; *);;

nrel_prev_attempt <- sc_node_non_role_relation;;
nrel_prev_attempt
=> nrel_main_idtf:
    [previous attempt*]
    (* <- lang_en;; *);;

nrel_timestamp <- sc_node_non_role_relation;;
nrel_timestamp
=> nrel_main_idtf:
    [timestamp of attempt*]
    (* <- lang_en;; *);;

nrel_source <- sc_node_non_role_relation;;
nrel_source
=> nrel_main_idtf:
    [source of attempt*]
    (* <- lang_en;; *);;

nrel_kind <- sc_node_non_role_relation;;
nrel_kind
=> nrel_main_idtf:
    [kind of attempt*]
    (* <- lang_en;; *);;

nrel_score <- sc_node_non_role_relation;;
nrel_score
=> nrel_main_idtf:
    [numeric score of attempt*]
    (* <- lang_en;; *);;

/* ---------- trajectory relations: what the dream cycle replays ---------- */

nrel_episode <- sc_node_non_role_relation;;
nrel_episode
=> nrel_main_idtf:
    [episode of attempt*]
    (* <- lang_en;; *);;

nrel_step_index <- sc_node_non_role_relation;;
nrel_step_index
=> nrel_main_idtf:
    [step index of attempt*]
    (* <- lang_en;; *);;

nrel_state <- sc_node_non_role_relation;;
nrel_state
=> nrel_main_idtf:
    [world state before attempt*]
    (* <- lang_en;; *);;

nrel_legal <- sc_node_non_role_relation;;
nrel_legal
=> nrel_main_idtf:
    [legal actions before attempt*]
    (* <- lang_en;; *);;

nrel_strategy <- sc_node_non_role_relation;;
nrel_strategy
=> nrel_main_idtf:
    [strategy that produced attempt*]
    (* <- lang_en;; *);;

nrel_note <- sc_node_non_role_relation;;
nrel_note
=> nrel_main_idtf:
    [note of attempt*]
    (* <- lang_en;; *);;

/* ---------- strategy and dream-cycle relations ---------- */

nrel_strategy_descriptor <- sc_node_non_role_relation;;
nrel_strategy_descriptor
=> nrel_main_idtf:
    [descriptor of strategy*]
    (* <- lang_en;; *);;

nrel_strategy_replay_score <- sc_node_non_role_relation;;
nrel_strategy_replay_score
=> nrel_main_idtf:
    [replay-estimated score of strategy*]
    (* <- lang_en;; *);;

nrel_strategy_online_score <- sc_node_non_role_relation;;
nrel_strategy_online_score
=> nrel_main_idtf:
    [online measured score of strategy*]
    (* <- lang_en;; *);;

nrel_derived_from <- sc_node_non_role_relation;;
nrel_derived_from
=> nrel_main_idtf:
    [strategy derived from*]
    (* <- lang_en;; *);;

nrel_dream_round <- sc_node_non_role_relation;;
nrel_dream_round
=> nrel_main_idtf:
    [dream round of strategy*]
    (* <- lang_en;; *);;

/* ---------- strategy class ---------- */

concept_strategy <- sc_node_class;;
concept_strategy
=> nrel_main_idtf:
    [strategy]
    (* <- lang_en;; *);;

concept_dream_cycle <- sc_node_class;;
concept_dream_cycle
=> nrel_main_idtf:
    [dream cycle]
    (* <- lang_en;; *);;

/* ---------- provenance constants ---------- */

source_direct <- concept;;
source_direct
=> nrel_main_idtf:
    [direct experience*]
    (* <- lang_en;; *);;

/* ---------- ablation flags ---------- */

concept_no_temporal <- concept;;
concept_no_temporal
=> nrel_main_idtf:
    [no temporal chaining*]
    (* <- lang_en;; *);;

source_hearsay <- concept;;
source_hearsay
=> nrel_main_idtf:
    [hearsay experience*]
    (* <- lang_en;; *);;

/* ---------- agent actions classified under information_action ---------- */

action_record_attempt <- sc_node_class;;
action_record_attempt
<= nrel_inclusion: information_action;;
action_record_attempt
=> nrel_main_idtf:
    [action. record an attempt of a subject]
    (* <- lang_en;; *);;

action_retrieve_attempts <- sc_node_class;;
action_retrieve_attempts
<= nrel_inclusion: information_action;;
action_retrieve_attempts
=> nrel_main_idtf:
    [action. retrieve attempts of a subject]
    (* <- lang_en;; *);;
