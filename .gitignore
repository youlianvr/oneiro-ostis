# Runtime artifacts of the running stack (volume-mounted into containers)
kb.bin/
logs/

# Installed product: the console tree and its virtualenv, built by
# scripts/install.py (CowAgent archive is in console/vendor/, the product's own
# files in console/overlay/). Never committed - a clone installs it.
.runtime/

# Build outputs
build/
install/
ConanPresets.json

# Standalone package build/test environment
.venv/
dist/
installer/payload/
*.egg-info/
.mypy_cache/

# Project-local credentials (never shipped or committed)
.env
.env.*

# Python
__pycache__/
*.pyc
.pytest_cache/

# Vendored IMS common KB: copied (not cloned) into knowledge-base/ for the
# container mount. Get it from https://github.com/ostis-apps/ims.ostis.kb
knowledge-base/ims.ostis.kb/
