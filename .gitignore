# Runtime artifacts of the running stack (volume-mounted into containers)
kb.bin/
logs/

# Runtime state a command creates while it holds the runtime. `graph-writer.lock` is the
# writer lease (`runtime.py`, `office_env.py`, `dream/measure.py`) taken in the data root;
# `state/`, `worktrees/` and `_tmp/` are evidence and scratch from the same runs.
# Kept out of the repository: none of it is source, and a clone would create its own.
graph-writer.lock
state/
worktrees/
_tmp/

# The project's own diagnostic and scratch area: graph snapshots, the
# installed-wheel smoke data, per-command scratch. Never committed - a run
# creates its own.
.runtime/

# Build outputs
build/
install/
ConanPresets.json

# Standalone package build/test environment
.venv/
dist/
installer/payload/
*.egg-info/
.mypy_cache/

# Project-local credentials (never shipped or committed)
.env
.env.*

# Python
__pycache__/
*.pyc
.pytest_cache/

# Vendored IMS common KB: copied (not cloned) into knowledge-base/ for the
# container mount. Get it from https://github.com/ostis-apps/ims.ostis.kb
knowledge-base/ims.ostis.kb/
